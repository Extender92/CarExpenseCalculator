# Browser entry point. This is the only port published by Compose.
WEB_PORT=8088

# Local PostgreSQL container configuration.
POSTGRES_DB=car_expense_calculator
POSTGRES_USER=car_expense_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Future Codex listing extraction (not read or used by the current release).
# Authentication is stored only in the dedicated Codex home; never place it here.
# CODEX_MODEL=gpt-5.6-luna
# CODEX_REASONING_EFFORT=medium
# CODEX_HOME_PATH=/mnt/user/appdata/car-expense-calculator/codex
